{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/tablet/obrigado/", "destination": "/tablet/", "permanent": true },
    { "source": "/tablet/o-mapa-do-tablet-velho.pdf", "destination": "/tablet/", "permanent": true },
    { "source": "/", "destination": "/30-dias/", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(fonts|img|og)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
