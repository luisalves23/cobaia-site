{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/30-dias/",
      "permanent": false
    },
    {
      "source": "/claude/",
      "destination": "/omniroute/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(fonts|img|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/tablet/g/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(acesso|minha-area|admin|gta/guia|notebook/guia)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/acesso/",
      "destination": "/api/acesso"
    },
    {
      "source": "/minha-area/",
      "destination": "/api/area"
    },
    {
      "source": "/admin/",
      "destination": "/api/admin"
    }
  ]
}