# Um serviço da máquina. Instância = nome do arquivo em maquina/servicos/ (ex.: cobaia@vendas, cobaia@acesso).
[Unit]
Description=Cobaia: servico %i
After=network-online.target
Wants=network-online.target

[Service]
User=cobaia
Group=cobaia
EnvironmentFile=/etc/cobaia/env
ExecStart=/usr/bin/node --no-warnings /opt/cobaia/site/maquina/servicos/%i.mjs
Restart=always
RestartSec=3
# Proteções: o serviço só escreve na pasta do banco
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cobaia
MemoryMax=300M

[Install]
WantedBy=multi-user.target
