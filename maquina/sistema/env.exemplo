# /etc/cobaia/env : as senhas e ajustes da máquina. NUNCA vai para o GitHub.
# O instalar.sh cria este arquivo e preenche SITE_HOST, SITE e SEGREDO sozinho.

# Endereço público. Provisório: <ip-com-traços>.sslip.io  ·  Depois: cobaia.dev.br
SITE_HOST=
SITE=

RAIZ_SITE=/opt/cobaia/site
BANCO=/var/lib/cobaia/cobaia.db
# Ramo do GitHub que a máquina segue (o atualizador puxa daqui a cada 5 min)
RAMO=main

# 64 letras aleatórias (o instalar.sh gera)
SEGREDO=

# Kiwify: o token de cada webhook (Kiwify > Apps > Webhooks), separados por vírgula
KIWIFY_TOKENS=
# Id do produto "suporte pessoal" (para reconhecer o order bump do notebook)
KIWIFY_SUPORTE_ID=

# E-mail: brevo | resend | console (console só imprime no log, para testar)
EMAIL_SERVICO=console
EMAIL_CHAVE=
EMAIL_DE=Luis do Cobaia <ola@cobaia.dev.br>
EMAIL_RESPONDER_PARA=

# WhatsApp de suporte, só números com 55 (aparece na área do aluno)
WHATSAPP_SUPORTE=
