// Publicação no Cloudflare (Workers + arquivos estáticos + banco D1). Explicação em plataforma/LEIAME.md
{
  "name": "cobaia",
  "main": "plataforma/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // O Worker vê todo pedido primeiro: os guias pagos nunca saem sem conferir a sessão.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "cobaia", "database_id": "PREENCHER_COM_O_ID_DO_D1" }
  ],
  // As configurações e senhas ficam no painel do Cloudflare; a publicação não apaga nada de lá.
  "keep_vars": true,
  "observability": { "enabled": true }
}
