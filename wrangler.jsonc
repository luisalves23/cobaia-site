// Site público em cobaia.dev.br (Cloudflare). Explicação em cloudflare/LEIAME.md
{
  "name": "cobaia-site",
  "main": "cloudflare/site.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // O Worker só roda nestes caminhos (guias pagos, obrigado, entradas antigas, /api).
    // O resto sai direto como arquivo, sem gastar a cota grátis de pedidos do Worker.
    // Os guias também ficam fora dos arquivos publicados (.assetsignore), então nunca vazam.
    "run_worker_first": [
      "/gta/guia*", "/gta/obrigado*", "/notebook/guia*", "/notebook/obrigado*", "/teste/guia*",
      "/tablet/g/*", "/tablet/g", "/tablet/obrigado*",
      "/acesso*", "/entrar*", "/minha-area*", "/admin*", "/api/*"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "cobaia.dev.br/*", "zone_name": "cobaia.dev.br" }],
  "observability": { "enabled": true }
}
