// Site público em cobaia.dev.br (Cloudflare). Explicação em cloudflare/LEIAME.md
{
  "name": "cobaia-site",
  "main": "cloudflare/site.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // O Worker vê todo pedido primeiro: guias pagos e páginas antigas nunca saem como arquivo.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "cobaia.dev.br/*", "zone_name": "cobaia.dev.br" }],
  "observability": { "enabled": true }
}
